{UTF-8}
Backlog Pressure  = A FUNCTION OF( )
	~	
	~		|

Judges Retired  = A FUNCTION OF( "No. of Judges") ~~|
Judges Retired=2/12
	~	Person/Month
	~		|

Case Arrival  = A FUNCTION OF( case registration rate,crime rate,New Filing Rate,Population\
		) ~~|
Case Arrival=Population*case registration rate*crime rate
	~	Cases/Month
	~		|

Judges Leaving  = A FUNCTION OF( "No. of Judges") ~~|
Judges Leaving=0.5/12
	~	Person/Month
	~		|

Litigation Rate  = A FUNCTION OF( Population)
	~	
	~		|

New Filing Rate  = A FUNCTION OF( Litigation Rate)
	~	
	~		|

Judges Appointment Rate  = A FUNCTION OF( Backlog Pressure,"No. of Judges",WIllingness to Become Judge\
		) ~~|
Judges Appointment Rate=2/12
	~	Person/Month
	~		|

Case withdrawl rate  = A FUNCTION OF( Dealy Length) ~~|
Case withdrawl rate=0.03
	~	Dmnl/Month
	~		|

WIllingness to Become Judge  = A FUNCTION OF( )
	~	
	~		|

Dealy Length  = A FUNCTION OF( )
	~	
	~		|

Birth=Population*rate*0.016/12
	~	Person/Month
	~		|

Case Complexity=6
	~	Month
	~		|

Case Disposal Rate=Case Handling Capacity*"No. of Judges"*Court Infrastructure/Case Complexity
	~	Cases/Month
	~		|

Case Disposed=Case Disposal Rate
	~	Cases/Month
	~		|

Case Handling Capacity=5
	~	Cases/Person
	~		|

case registration rate=0.98
	~	Cases/crime/Month
	~		|

Case Withdrawal="No. of Pending Cases"*Case withdrawl rate
	~	Cases/Month
	~		|

Court Infrastructure=0.9
	~	Dmnl
	~		|

crime rate=1/1e+07
	~	crime/Person
	~		|

Death Rate=Population*rate*0.009/12
	~	Person/Month
	~		|

Population= INTEG (Birth-Death Rate,
		1.28659e+09)
	~	Person
	~		|

"No. of Judges"= INTEG (Judges Appointment Rate-Judges Leaving-Judges Retired,
		70)
	~	Person
	~		|

"No. of Pending Cases"= INTEG (Case Arrival-Case Disposed-Case Withdrawal,
		100)
	~	Cases [0,?]
	~		|

rate=1
	~	1/Month
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

