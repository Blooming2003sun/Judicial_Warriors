{UTF-8}
dispose rate constant=1
	~	Dmnl/year
	~		|

Case Disposed="No. of Pending Cases" * (1 - EXP(- Effective Capacity / "No. of Pending Cases"\
		/dispose rate constant))*dispose rate constant
	~	Cases/year
	~		|

Actual Delay="No. of Pending Cases" / MAX(1, Case Disposed)
	~	year
	~		|

Backlog Pressure="No. of Pending Cases" / MAX(1, "No. of Judges")
	~	Cases/Person
	~		|

Base complexity=1.5
	~	Dmnl
	~		|

Base Filing Rate=1e-05
	~	Cases/(Person*year)
	~		|

Base Productivity=40
	~	Cases/(Person*year)
	~		|

Judges Retired=Retirement Fraction*"No. of Judges"
	~	Person/year
	~		|

Burnout threshold=200
	~	Cases/Person
	~		|

Case Arrival=Population*Total Filling rate
	~	Cases/year
	~		|

Case Complexity=Base complexity * (1 + Complexity factor)
	~	Dmnl
	~		|

Case Handling Capacity=Productivity/Case Complexity
	~	Cases/(Person*year)
	~		|

Perceived Delay= INTEG ( (Actual Delay - Perceived Delay) / Delay adjustment time,
		 2)
	~	year
	~		|

Case withdrawl rate=Max Withdrawal / (1 + EXP(-withdrawal sensitivity * (Perceived Delay\
		 - delay threshold)))
	~	1/year
	~		|

Complexity factor=0.2
	~	Dmnl
	~		|

Desired Judges="No. of Pending Cases"/ Target cases per judge
	~	Person
	~		|

Delay adjustment time=1
	~	year
	~		|

Delay Sensitivity=2
	~	year
	~		|

delay threshold=3
	~	year
	~		|

Judges Leaving=Leaving Fraction*"No. of Judges"
	~	Person/year
	~		|

Effective Capacity=Case Handling Capacity*"No. of Judges"
	~	Cases/year
	~		|

Hiring Pressure=(Desired Judges - "No. of Judges") / MAX(1,"No. of Judges")
	~	Dmnl
	~		|

Judges Appointment Rate=Max hiring rate * (Hiring Pressure / (1 + ABS(Hiring Pressure\
		)))
	~	Person/year
	~		|

Max Withdrawal=0.05
	~	1/year
	~		|

withdrawal sensitivity=1.5
	~	1/year
	~		|

Leaving Fraction=0.02
	~	1/year
	~		|

Max hiring rate=100
	~	Person/year
	~		|

Target cases per judge=100
	~	Cases/Person
	~		|

Productivity=Base Productivity * (1 - TANH(Backlog Pressure / Burnout threshold))
	~	Cases/(Person*year)
	~		|

Retirement Fraction=0.03
	~	1/year
	~		|

Total Filling rate=Base Filing Rate / (1 + Perceived Delay / Delay Sensitivity)
	~	Cases/(Person*year)
	~		|

Birth=Population*rate*0.016
	~	Person/year
	~		|

Case Withdrawal="No. of Pending Cases"*Case withdrawl rate
	~	Cases/year
	~		|

Death Rate=Population*rate*0.016
	~	Person/year
	~		|

Population= INTEG (Birth-Death Rate,
		1.28659e+09)
	~	Person
	~		|

"No. of Judges"= INTEG (Judges Appointment Rate-Judges Leaving-Judges Retired,
		70)
	~	Person
	~		|

"No. of Pending Cases"= INTEG (Case Arrival-Case Disposed-Case Withdrawal,
		100)
	~	Cases [0,?]
	~		|

rate=1
	~	1/year
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	year [0,?]
	~	The time step for the simulation.
	|

